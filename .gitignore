# Logs
logs
*.log
bun.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local
.env.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Android release signing — NEVER commit the keystore or its passwords.
# Back them up privately; losing them means the app can never be updated.
*.keystore
*.jks
keystore.properties
*.apk
*.aab

# ...except the sideload build, which is deliberately published so testers can
# download it from the site. Keep this as the ONLY apk/aab in the repo: if a
# build ever committed both, the old one would win at the same URL depending on
# case-insensitive filesystem ordering, and a tester would silently install the
# version we are trying to replace.
!public/wesuplus.apk

# iOS build artifacts (regenerated on the Mac via cap sync + pod install).
ios/App/App/public/
ios/App/Pods/
ios/App/*.xcworkspace
*.xcuserdata/
DerivedData/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

e2e artifacts
.e2e-baseline.json

# Kotlin build sessions (generated, machine-local)
android/.kotlin/
